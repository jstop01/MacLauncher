<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<resources>
    <style name="CalCell.Light">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CalEvent.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MusicButton.Light">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="StAppName.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StAppTime.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="FinderSideHeader.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FinderSideItem.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxHeight">30dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StorageRow.Light">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="StorageLabel.Light">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StorageValue.Light">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8E8E93</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
