<?xml version="1.0" encoding="utf-8"?>
<!-- 자정 알람으로 넘어가고, 30분 주기 갱신은 놓친 경우 대비 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_calendar_description"
    android:initialLayout="@layout/widget_calendar"
    android:previewLayout="@layout/widget_calendar"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="150dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
