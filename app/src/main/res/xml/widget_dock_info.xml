<?xml version="1.0" encoding="utf-8"?>
<!-- 추가할 때 앱 고르기는 선택(configuration_optional), 나중에 위젯 설정으로 다시 고를 수 있음(reconfigurable) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.jex.maclauncher.widget.dock.DockConfigActivity"
    android:description="@string/widget_dock_description"
    android:initialLayout="@layout/widget_dock"
    android:previewLayout="@layout/widget_dock"
    android:minWidth="250dp"
    android:minHeight="56dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:targetCellWidth="5"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
