<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 머리: 아이콘 · 남은 개수 · + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_reminders" />

            <TextView android:id="@+id/skin_t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="미리 알림"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/rem_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="#0A84FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rem_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#0A84FF"
            android:textSize="28sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/widget_divider_light" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/rem_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <TextView
            android:id="@+id/rem_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="미리 알림 없음 · + 로 추가"
            android:textColor="#AEAEB2"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/rem_clear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:textColor="#990A84FF"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
</FrameLayout>
