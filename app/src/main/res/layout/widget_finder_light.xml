<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<!-- macOS Finder 창 모양 위젯: 제목 막대 / 사이드바 + 파일 격자 / 상태 막대 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 제목 막대: 신호등(닫기·최소화·최대화) · ◀ · 폴더 이름. 최소화하면 이 막대만 남음 -->
    <LinearLayout
        android:id="@+id/finder_titlebar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 점은 11dp, 누르는 영역은 패딩으로 넓힘 -->
        <ImageView android:id="@+id/finder_close" android:layout_width="25dp" android:layout_height="32dp" android:paddingHorizontal="7dp" android:paddingVertical="10.5dp" android:src="@drawable/dot_red" />
        <ImageView android:id="@+id/finder_minimize" android:layout_width="25dp" android:layout_height="32dp" android:paddingHorizontal="7dp" android:paddingVertical="10.5dp" android:src="@drawable/dot_yellow" />
        <ImageView android:id="@+id/finder_zoom" android:layout_width="25dp" android:layout_height="32dp" android:paddingHorizontal="7dp" android:paddingVertical="10.5dp" android:src="@drawable/dot_green" />

        <TextView
            android:id="@+id/finder_back"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#1C1C1E"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/finder_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#1C1C1E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 제목을 가운데 두려고 왼쪽 신호등+◀ 폭만큼 비워둠 -->
        <TextView
            android:id="@+id/finder_refresh"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="40dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#8E8E93"
            android:textSize="16sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/finder_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/widget_divider_light" />

    <LinearLayout
        android:id="@+id/finder_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 사이드바 (위젯이 좁으면 숨김) -->
        <LinearLayout
            android:id="@+id/finder_sidebar"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:background="@drawable/finder_sidebar_bg_light"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView style="@style/FinderSideHeader.Light" android:text="즐겨찾기" />
            <TextView
                android:id="@+id/side_favorites"
                style="@style/FinderSideItem.Light"
                android:text="즐겨찾는 앱" />
            <TextView
                android:id="@+id/side_recent_apps"
                style="@style/FinderSideItem.Light"
                android:text="최근 사용 앱" />
            <TextView
                android:id="@+id/side_recent"
                style="@style/FinderSideItem.Light"
                android:text="최근 항목" />
            <TextView
                android:id="@+id/side_apps"
                style="@style/FinderSideItem.Light"
                android:text="응용 프로그램" />
            <TextView
                android:id="@+id/side_download"
                style="@style/FinderSideItem.Light"
                android:text="다운로드" />
            <TextView
                android:id="@+id/side_documents"
                style="@style/FinderSideItem.Light"
                android:text="문서" />
            <TextView
                android:id="@+id/side_photos"
                style="@style/FinderSideItem.Light"
                android:text="사진" />
            <TextView
                android:id="@+id/side_music"
                style="@style/FinderSideItem.Light"
                android:text="음악" />
            <TextView
                android:id="@+id/side_movies"
                style="@style/FinderSideItem.Light"
                android:text="동영상" />

            <TextView style="@style/FinderSideHeader.Light" android:layout_marginTop="6dp" android:text="위치" />
            <TextView
                android:id="@+id/side_phone"
                style="@style/FinderSideItem.Light"
                android:text="내 폰" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/finder_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnWidth="76dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="4dp" />

            <TextView
                android:id="@+id/finder_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="항목 없음"
                android:textColor="#AEAEB2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/finder_permission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="12dp"
                android:text="파일을 보려면 '모든 파일 접근' 권한이 필요해요\n\n탭해서 허용하기"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/finder_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#8E8E93"
        android:textSize="11sp" />

    <!-- 최소화 상태: 신호등 버튼 자리(왼쪽 위)에 이 아이콘만 남음, 탭하면 다시 펼침 -->
    <ImageView
        android:id="@+id/finder_mini"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="start|top"
        android:contentDescription="Finder 펼치기"
        android:src="@drawable/ic_finder_face"
        android:visibility="gone" />
</LinearLayout>
