<?xml version="1.0" encoding="utf-8"?>
<!-- 달력 작은 크기: macOS 작은 캘린더 위젯처럼 요일 / 날짜 / 다음 일정 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
    android:id="@+id/cal_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/cal_small_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF453A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cal_small_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="40sp" />

    <!-- 다음 일정 최대 2개 (일정이 없거나 권한이 없으면 안내 한 줄) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cal_small_ev0"
            style="@style/CalEvent" />

        <TextView
            android:id="@+id/cal_small_ev1"
            style="@style/CalEvent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/cal_small_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
