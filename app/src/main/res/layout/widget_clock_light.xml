<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<!-- 세계 시계: 도시 4개 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="horizontal"
    android:padding="12dp">
        <LinearLayout
            android:id="@+id/clk_slot0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#8E8E93"
                android:textSize="11sp" />
        </LinearLayout>
</LinearLayout>
