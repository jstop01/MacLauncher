<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<!-- 스크린 타임 작은 크기: 오늘 합계 + 많이 쓴 앱 3개 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light" />

    <LinearLayout
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView android:id="@+id/skin_t1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스크린 타임"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/st_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1C1C1E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/st_chart"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginVertical="6dp"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/st_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="사용 시간을 보려면 탭해서 '사용 정보 접근' 허용"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/st_app0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/st_app_icon0" android:layout_width="22dp" android:layout_height="22dp" />
        <TextView
            android:id="@+id/st_app_name0"
            style="@style/StAppName.Light"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
        <TextView android:id="@+id/st_app_time0" style="@style/StAppTime.Light" android:layout_width="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/st_app1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/st_app_icon1" android:layout_width="22dp" android:layout_height="22dp" />
        <TextView
            android:id="@+id/st_app_name1"
            style="@style/StAppName.Light"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
        <TextView android:id="@+id/st_app_time1" style="@style/StAppTime.Light" android:layout_width="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/st_app2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/st_app_icon2" android:layout_width="22dp" android:layout_height="22dp" />
        <TextView
            android:id="@+id/st_app_name2"
            style="@style/StAppName.Light"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1" />
        <TextView android:id="@+id/st_app_time2" style="@style/StAppTime.Light" android:layout_width="wrap_content" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
