<?xml version="1.0" encoding="utf-8"?>
<!-- 세계 시계: 도시 4개. 배경은 Skin 팩이 런타임에 입힌다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

<LinearLayout
    android:id="@+id/clk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp">
        <LinearLayout
            android:id="@+id/clk_slot0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clk_slot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <AnalogClock
                android:id="@+id/clk_face3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:dial="@drawable/clock_dial_fallback"
                android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />

            <TextView
                android:id="@+id/clk_city3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clk_offset3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
</LinearLayout>
</FrameLayout>
