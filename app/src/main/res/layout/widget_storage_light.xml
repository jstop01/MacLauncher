<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_drive" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 폰"
                android:textColor="#1C1C1E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/st_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/st_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#8E8E93"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 항목별 색 막대 (비트맵) -->
    <ImageView
        android:id="@+id/st_bar"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/st_legend"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout style="@style/StorageRow.Light">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_apps" />
            <TextView style="@style/StorageLabel.Light" android:text="앱 · 시스템" />
            <TextView android:id="@+id/st_apps" style="@style/StorageValue.Light" />
        </LinearLayout>
        <LinearLayout style="@style/StorageRow.Light">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_photos" />
            <TextView style="@style/StorageLabel.Light" android:text="사진" />
            <TextView android:id="@+id/st_photos" style="@style/StorageValue.Light" />
        </LinearLayout>
        <LinearLayout style="@style/StorageRow.Light">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_videos" />
            <TextView style="@style/StorageLabel.Light" android:text="동영상" />
            <TextView android:id="@+id/st_videos" style="@style/StorageValue.Light" />
        </LinearLayout>
        <LinearLayout style="@style/StorageRow.Light">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_music" />
            <TextView style="@style/StorageLabel.Light" android:text="음악" />
            <TextView android:id="@+id/st_music" style="@style/StorageValue.Light" />
        </LinearLayout>
        <LinearLayout style="@style/StorageRow.Light">
            <ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/dot_docs" />
            <TextView style="@style/StorageLabel.Light" android:text="문서 · 기타" />
            <TextView android:id="@+id/st_docs" style="@style/StorageValue.Light" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/st_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="항목별 용량을 보려면 '모든 파일 접근' 권한이 필요해요 · 탭해서 허용"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
