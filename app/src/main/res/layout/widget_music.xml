<?xml version="1.0" encoding="utf-8"?>
<!-- macOS '지금 재생 중': 앨범 아트 | 제목·가수·버튼 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
    android:id="@+id/music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/music_art"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:background="@drawable/music_art_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note" />

    <LinearLayout
        android:id="@+id/music_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1.2"
        android:orientation="vertical">
        <TextView
            android:id="@+id/music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/music_prev" style="@style/MusicButton" android:src="@drawable/ic_media_prev" android:contentDescription="이전 곡" />
            <ImageView android:id="@+id/music_play" style="@style/MusicButton" android:src="@drawable/ic_media_play" android:contentDescription="재생/일시정지" />
            <ImageView android:id="@+id/music_next" style="@style/MusicButton" android:src="@drawable/ic_media_next" android:contentDescription="다음 곡" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
