<?xml version="1.0" encoding="utf-8"?>
<!-- tools/gen_light_widgets.py 가 만든 파일. 직접 고치지 말 것 -->
<!-- macOS 스크린 타임: 오늘 합계 / 시간대별 막대(분류별 색) / 많이 쓴 앱 3개 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_light" />

    <LinearLayout
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스크린 타임"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/st_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1C1C1E"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/st_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="8dp"
        android:layout_weight="1"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/st_legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#8E8E93"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/st_hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="사용 시간을 보려면 탭해서 '사용 정보 접근' 허용"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/st_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/st_app0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/st_app_icon0" android:layout_width="28dp" android:layout_height="28dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/st_app_name0" style="@style/StAppName.Light" />
                <TextView android:id="@+id/st_app_time0" style="@style/StAppTime.Light" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/st_app1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/st_app_icon1" android:layout_width="28dp" android:layout_height="28dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/st_app_name1" style="@style/StAppName.Light" />
                <TextView android:id="@+id/st_app_time1" style="@style/StAppTime.Light" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/st_app2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/st_app_icon2" android:layout_width="28dp" android:layout_height="28dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/st_app_name2" style="@style/StAppName.Light" />
                <TextView android:id="@+id/st_app_time2" style="@style/StAppTime.Light" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
