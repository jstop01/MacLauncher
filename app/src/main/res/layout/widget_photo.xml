<?xml version="1.0" encoding="utf-8"?>
<!-- macOS 사진 위젯: 사진 한 장 + 찍은 날짜. 모서리는 배경 모양으로 잘라냄 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 감성 팩 패널 배경 (Skin.dress가 비트맵으로 교체). src는 미리보기용 기본값 -->
    <ImageView
        android:id="@+id/skin_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <FrameLayout
    android:id="@+id/photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/photo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:src="@drawable/photo_scrim"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/photo_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="14dp"
        android:shadowColor="#80000000"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/photo_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
</FrameLayout>
