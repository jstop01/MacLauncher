<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 시스템 모니터 위젯 1초 갱신용 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Finder 위젯: 폰 전체 폴더 보기 (Android 11+는 '모든 파일 접근', 10은 읽기 권한).
         사진 위젯은 Android 12까지 읽기 권한, 13+는 READ_MEDIA_IMAGES -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 배터리 위젯: 연결된 블루투스 기기 배터리 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Finder '최근 사용 앱': 설정 > 사용 정보 접근에서 사용자가 허용 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 타이머 위젯: 끝나는 순간 정확히 깨어나 알림 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- 네트워크 위젯: 연결 종류(Wi-Fi/모바일) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 사진 위젯 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 달력 위젯: 일정 표시 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 재부팅 후 갱신 재시작 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 날씨 위젯: Open-Meteo 호출 + 현재 위치 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Dock 위젯: 실행 가능한 앱 목록 보기 (Android 11+ 패키지 가시성) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 시스템 모니터/저장 공간 위젯 → 삼성 디바이스 케어 화면 찾기 -->
        <package android:name="com.samsung.android.lool" />
        <intent>
            <action android:name="com.samsung.android.sm.ACTION_DASHBOARD" />
        </intent>
        <intent>
            <action android:name="com.samsung.android.sm.ACTION_STORAGE" />
        </intent>
        <intent>
            <action android:name="com.samsung.android.sm.ACTION_RAM" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MacLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MonitorWidget"
            android:exported="false"
            android:label="@string/widget_monitor_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_monitor_info" />
        </receiver>

        <receiver
            android:name=".widget.CalendarWidget"
            android:exported="false"
            android:label="@string/widget_calendar_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <!-- 캘린더 일정이 바뀌면 다시 그림 -->
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data android:scheme="content" android:host="com.android.calendar" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <receiver
            android:name=".widget.finder.FinderWidget"
            android:exported="false"
            android:label="@string/widget_finder_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finder_info" />
        </receiver>

        <service
            android:name=".widget.finder.FinderItemsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".widget.finder.FinderOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MacLauncher.Trampoline" />

        <activity
            android:name=".widget.finder.FavoritesActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.dock.DockWidget"
            android:exported="false"
            android:label="@string/widget_dock_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dock_info" />
        </receiver>

        <!-- 런처가 위젯 추가/설정 때 여는 화면이라 exported -->
        <activity
            android:name=".widget.dock.DockConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.StorageWidget"
            android:exported="false"
            android:label="@string/widget_storage_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_storage_info" />
        </receiver>

        <receiver
            android:name=".widget.reminders.RemindersWidget"
            android:exported="false"
            android:label="@string/widget_reminders_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reminders_info" />
        </receiver>

        <service
            android:name=".widget.reminders.RemindersService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".widget.reminders.ReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MacLauncher.Trampoline"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".widget.BatteryWidget"
            android:exported="false"
            android:label="@string/widget_battery_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_battery_info" />
        </receiver>

        <receiver
            android:name=".widget.apps.AppsWidget"
            android:exported="false"
            android:label="@string/widget_apps_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_apps_info" />
        </receiver>

        <service
            android:name=".widget.apps.AppsItemsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".widget.apps.AppLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MacLauncher.Trampoline" />

        <receiver
            android:name=".widget.ClockWidget"
            android:exported="false"
            android:label="@string/widget_clock_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <receiver
            android:name=".widget.WeatherWidget"
            android:exported="false"
            android:label="@string/widget_weather_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name=".widget.sticky.StickyWidget"
            android:exported="false"
            android:label="@string/widget_sticky_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sticky_info" />
        </receiver>

        <activity
            android:name=".widget.sticky.StickyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MacLauncher.Trampoline"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".widget.PhotoWidget"
            android:exported="false"
            android:label="@string/widget_photo_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_photo_info" />
        </receiver>

        <receiver
            android:name=".widget.music.MusicWidget"
            android:exported="false"
            android:label="@string/widget_music_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music_info" />
        </receiver>

        <!-- '알림 접근'으로 다른 앱의 재생 정보를 읽음 (알림 내용은 안 씀) -->
        <service
            android:name=".widget.music.MusicListenerService"
            android:exported="true"
            android:label="@string/music_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.screentime.ScreenTimeWidget"
            android:exported="false"
            android:label="@string/widget_screentime_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screentime_info" />
        </receiver>

        <receiver
            android:name=".widget.shortcuts.ShortcutsWidget"
            android:exported="false"
            android:label="@string/widget_shortcuts_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shortcuts_info" />
        </receiver>

        <!-- 런처가 위젯 추가/설정 때 여는 화면이라 exported -->
        <activity
            android:name=".widget.shortcuts.ShortcutsConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TimerWidget"
            android:exported="false"
            android:label="@string/widget_timer_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>

        <receiver
            android:name=".widget.network.NetworkWidget"
            android:exported="false"
            android:label="@string/widget_network_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_network_info" />
        </receiver>

        <receiver
            android:name=".widget.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".widget.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Home screen widget that shows live CPU and memory usage" />
        </service>
    </application>
</manifest>
